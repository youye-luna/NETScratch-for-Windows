IDI_ICON1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "youye-luna"
            VALUE "FileDescription", "NETScratch"
            VALUE "FileVersion", "2.0-beta"
            VALUE "InternalName", "NETScratch"
            VALUE "LegalCopyright", "Copyright (C) 2026 youye-luna"
            VALUE "OriginalFilename", "NETScratch.exe"
            VALUE "ProductName", "NETScratch"
            VALUE "ProductVersion", "2.0-beta"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
